{
  "name": "@wasel/api",
  "version": "1.0.0",
  "private": true,
  "description": "WaselERP modular monolith API (NestJS + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "node ../../tools/pg/run-sql.js wasel ../../db/schema.postgres.sql",
    "db:seed": "node dist/cli/seed.js",
    "test:purchases": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/purchase-receipt.test.ts",
    "test:purchases-invoice": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/purchase-invoice.test.ts",
    "test:purchases-match": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/purchase-match.test.ts",
    "test:purchases-statement": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/supplier-statement.test.ts",
    "test:credit-limit": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/credit-limit.test.ts",
    "test:sales-return": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/sales-return.test.ts",
    "test:sales-return-extra": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/sales-return-extra.test.ts",
    "test:sales-credit-note": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/sales-credit-note.test.ts",
    "test:sales-integration": "ts-node --transpile-only -P tests/tsconfig.json tests/purchases/sales-integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
